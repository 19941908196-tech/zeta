{
  "name": "zeta-app",
  "version": "1.0.0",
  "description": "Zeta - 个人财产监控平台",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:init": "npx cap init Zeta com.zeta.app --web-dir=dist",
    "android:add": "npx cap add android",
