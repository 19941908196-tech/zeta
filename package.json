    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@capacitor/cli": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  }
}
